import("//build/test.gni")
import("../../../config.gni")

module_output_path = "audio_framework/audio_loopback"

group("moduletest") {
  testonly = true

  deps = [
    ":audio_loopback_control_test",
  ]
}

ohos_moduletest("audio_loopback_control_test") {
  module_out_path = module_output_path
  include_dirs = [
    "./1.0/include",
    "../../../interfaces/inner_api/native/audioloopback/include",
    "../../../interfaces/inner_api/native/audiocommon/include",
    "../../../interfaces/inner_api/native/audiomanager/include",
  ]

  sources = [ "1.0/src/audio_loopback_control_test.cpp" ]

  deps = [
    "../../../frameworks/native/audioloopback:audio_loopback",
    "../../../services/audio_service:audio_policy_manager",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]
}