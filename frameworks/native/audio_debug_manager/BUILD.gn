import("//build/ohos.gni")
import("../../../config.gni")

config("audio_debug_manager_config") {
  include_dirs = [
    "../../../interfaces/inner_api/native/audiocommon/include",
    "../../../interfaces/inner_api/native/audio_debug_manager/include",
    "../audiodefinitions/include",
    "./include",
  ]
  cflags = [
    "-Wall",
    "-Werror",
  ]
}

config("audio_external_library_config") {
  include_dirs = [ "../../../interfaces/inner_api/native/audio_debug_manager/include" ]
}

ohos_shared_library("audio_debug_manager") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    debug = false
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
  }
  install_enable = true

  configs = [ ":audio_debug_manager_config" ]

  sources = [ "src/audio_debug_manager.cpp" ]

  cflags_cc = [ "-std=c++20" ]

  deps = [
    "../audiodefinitions:audio_definitions",
    "../audioutils:audio_utils",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]

  public_configs = [ ":audio_external_library_config" ]

  version_script = "../../../audio_framework.versionscript"
  innerapi_tags = [ "platformsdk" ]

  part_name = "audio_framework"
  subsystem_name = "multimedia"
}
