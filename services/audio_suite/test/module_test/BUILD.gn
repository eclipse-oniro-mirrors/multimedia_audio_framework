import("//build/ohos.gni")
import("../../../../config.gni")

if (audio_framework_feature_audiosuite_support) {
  ohos_executable("audio_pcm_process_module_test") {
    install_enable = false

    sanitize = {
      cfi = true
      cfi_cross_dso = true
      cfi_vcall_icall_only = true
      debug = false
      integer_overflow = true
      ubsan = true
      boundary_sanitize = true
    }

    include_dirs = [
      "../../../../interfaces/inner_api/native/audio_pcm_process/include",
    ]

    sources = [
      "src/audio_pcm_process_module_test.cpp",
    ]

    deps = [
      "../..:audio_pcm_process",
    ]

    external_deps = [
      "c_utils:utils",
    ]

    subsystem_name = "multimedia"
    part_name = "audio_framework"
  }
}